<%= field_wrapper **field_wrapper_args, full_width: true do %>
  <%= content_tag :div, class: "relative block overflow-x-auto max-w-4xl" do %>
    <%= content_tag 'avo-rhino-editor',
      data:,
      input: unique_id,
      class: class_names(unique_id),
      placeholder: @field.placeholder do %>
      <%# A label rather than a button around each colour input: a button may not contain an
          interactive element, and clicking a label opens its input's picker natively, which is
          all the button's click handler did. Enter and Space still open it from the keyboard
          through that handler, since a label has no activation key of its own. %>
      <label
        slot="after-link-button"
        class="toolbar__button rhino-toolbar-button flex flex-col items-center grow-0 text-sm hidden-until-rhino-boots-up"
        data-role="toolbar-item"
        tabindex="-1"
        data-action="keydown.enter->rhino-field#openTextColorPicker keydown.space->rhino-field#openTextColorPicker:prevent"
      >
        <%= helpers.svg "heroicons/outline/swatch", class: "!min-h-4 !max-h-4" %>
        <input
          type="color"
          autocomplete="off"
          data-action="input->rhino-field#setTextColor"
          data-rhino-field-target="textColorInput"
          class="h-3.5 w-5 bg-transparent -mt-px -mb-1 p-0">
      </label>
      <label
        slot="after-link-button"
        class="toolbar__button rhino-toolbar-button flex flex-col items-center grow-0 text-sm hidden-until-rhino-boots-up"
        data-role="toolbar-item"
        tabindex="-1"
        data-action="keydown.enter->rhino-field#openBackgroundColorPicker keydown.space->rhino-field#openBackgroundColorPicker:prevent"
      >
        <%= helpers.svg "avo/gradient", class: "!min-h-4 !max-h-4" %>
        <input
          type="color"
          autocomplete="off"
          data-action="input->rhino-field#setBackgroundColor"
          data-rhino-field-target="backgroundColorInput"
          class="h-3.5 w-5 bg-transparent -mt-px -mb-1 p-0">
      </label>
      <a
        slot="before-attach-files-button"
        class="toolbar__button rhino-toolbar-button flex flex-col items-center grow-0 text-sm hidden-until-rhino-boots-up"
        data-role="toolbar-item"
        tabindex="-1"
        href="<%= helpers.avo.attach_media_path(resource_name: @resource.name, record_id: @resource.id, controller_selector: ".#{unique_id}", controller_name: 'rhino-field', turbo_frame: ::Avo::MODAL_FRAME_ID) %>"
        data-turbo-frame="<%= ::Avo::MODAL_FRAME_ID %>"
      >
        <%= helpers.svg "heroicons/outline/photo", class: "!min-h-4 !max-h-4" %>
      </a>
    <% end %>
    <%= @form.text_area @field.id,
      value: @field.value.try(:to_trix_html) || @field.value,
      class: classes("w-full hidden"),
      data: @field.get_html(:data, view: view, element: :input),
      disabled: disabled?,
      id: unique_id,
      placeholder: @field.placeholder,
      style: @field.get_html(:style, view: view, element: :input)
    %>
  <% end %>
<% end %>
